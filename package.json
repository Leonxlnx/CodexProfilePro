{
  "name": "codex-profile-remake",
  "version": "0.1.8",
  "description": "Local Codex profile dashboard with token heatmaps, cost estimates, tray launcher, and desktop builds.",
  "author": {
    "name": "Leon",
    "email": "Leonxlnx@users.noreply.github.com"
  },
  "main": "profile-remake/electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "sync": "node profile-remake/fast-codex-usage-export.mjs profile-remake/slopmeter.json",
    "test": "npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.lexn8.codex-profile-remake",
    "productName": "Codex Profile",
    "asar": true,
    "asarUnpack": [
      "profile-remake/fast-codex-usage-export.mjs"
    ],
    "files": [
      "profile-remake/**/*",
      "!profile-remake/slopmeter.json",
      "!profile-remake/slopmeter.*.json",
      "package.json"
    ],
    "extraMetadata": {
      "main": "profile-remake/electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "profile-remake/assets/profile.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "profile-remake/assets/profile.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "profile-remake/assets/profile-icon.png",
      "maintainer": "Leonxlnx <Leonxlnx@users.noreply.github.com>",
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
